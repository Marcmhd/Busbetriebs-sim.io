  <script>
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if(entry.isIntersecting){
          entry.target.classList.add('in-view');
        }
      });
    }, { threshold: 0.14 });

    reveals.forEach(el => observer.observe(el));

    const mapItems = document.querySelectorAll('.map-item');
    const detailTitle = document.getElementById('detailTitle');
    const detailSubtitle = document.getElementById('detailSubtitle');
    const detailLines = document.getElementById('detailLines');
    const detailOps = document.getElementById('detailOps');
    const detailStops = document.getElementById('detailStops');

    function updateDetail(item){
      mapItems.forEach(el => {
        el.classList.remove('active');
        el.setAttribute('aria-selected', 'false');
      });

      item.classList.add('active');
      item.setAttribute('aria-selected', 'true');

      detailTitle.textContent = item.dataset.title;
      detailSubtitle.textContent = item.dataset.subtitle;
      detailOps.textContent = item.dataset.ops;

      detailLines.innerHTML = '';
      item.dataset.lines.split(',').forEach(line => {
        const badge = document.createElement('span');
        badge.textContent = line.trim();
        detailLines.appendChild(badge);
      });

      detailStops.innerHTML = '';
      item.dataset.stops.split(';').forEach(stopEntry => {
        const [name, type] = stopEntry.split('|');
        const stop = document.createElement('div');
        stop.className = 'stop';
        stop.innerHTML = `
          <div class="dot"></div>
          <strong>${name}</strong>
          <small>${type}</small>
        `;
        detailStops.appendChild(stop);
      });
    }

    mapItems.forEach(item => {
      item.addEventListener('click', () => updateDetail(item));
      item.addEventListener('keydown', (e) => {
        if(e.key === 'Enter' || e.key === ' '){
          e.preventDefault();
          updateDetail(item);
        }
      });
    });

    const registerForm = document.getElementById('registerForm');
    const formStatus = document.getElementById('formStatus');

    registerForm.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = document.getElementById('name').value.trim();
      if(!name){
        formStatus.textContent = 'Bitte fülle zuerst alle Pflichtfelder aus.';
        formStatus.style.color = '#ba3a1b';
        return;
      }

      formStatus.textContent = `Danke ${name} – deine Bewerbung wurde vorgemerkt. In einer echten Version könnte sie jetzt an Discord, E-Mail oder eine Datenbank gesendet werden.`;
      formStatus.style.color = '#296b3d';
      registerForm.reset();
    });
  </script>
</body>
</html>
